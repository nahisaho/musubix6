{
  "schemaVersion": 1,
  "testCmd": [
    "node",
    "--test",
    "--test-name-pattern",
    "{id}",
    "{file}"
  ],
  "checks": [],
  "timeoutMs": 120000,
  "projects": [
    {
      "root": "api",
      "testCmd": [
        "npx",
        "vitest",
        "run",
        "{file}",
        "-t",
        "{id}"
      ],
      "checks": [
        {
          "name": "typecheck",
          "cmd": [
            "npm",
            "run",
            "typecheck"
          ]
        },
        {
          "name": "test",
          "cmd": [
            "npm",
            "run",
            "test"
          ],
          "changedCmd": [
            "npx",
            "vitest",
            "related",
            "--run",
            "{changedFiles}"
          ],
          "hubFallbackCmd": [
            "npx",
            "vitest",
            "run",
            "{changedTests}",
            "{directTests}"
          ]
        }
      ],
      "dependsOn": [
        "contract"
      ]
    },
    {
      "root": "worker",
      "testCmd": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "{file}",
        "-k",
        "{idu}"
      ],
      "checks": [
        {
          "name": "test",
          "cmd": [
            "python3",
            "-m",
            "pytest",
            "-q"
          ]
        }
      ],
      "dependsOn": [
        "contract"
      ]
    }
  ]
}