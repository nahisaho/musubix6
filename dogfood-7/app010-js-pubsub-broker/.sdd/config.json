{
  "schemaVersion": 1,
  "testCmd": [
    "node",
    "--test",
    "--test-name-pattern",
    "{id}(?![0-9A-Za-z])",
    "{file}"
  ],
  "checks": [
    {
      "name": "test",
      "cmd": ["npm", "test"],
      "changedCmd": ["node", "--test", "{changedTests}"],
      "hubFallbackCmd": ["node", "--test", "{changedTests}"]
    }
  ],
  "timeoutMs": 120000
}
