{
  "testCmd": [
    "node",
    "--test",
    "--test-name-pattern",
    "{id}(?![0-9A-Za-z])",
    "{file}"
  ],
  "checks": [
    {
      "name": "test",
      "cmd": [
        "node",
        "--test",
        "TEST-NOMATCH-001.test.mjs"
      ]
    }
  ],
  "scan": {
    "include": [
      "*.mjs"
    ]
  },
  "timeoutMs": 10000
}
