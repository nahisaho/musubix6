{
  "schemaVersion": 1,
  "testCmd": [
    "go",
    "test",
    "./...",
    "-run",
    "{IDU}(_|$)"
  ],
  "checks": [
    {
      "name": "test",
      "cmd": [
        "go",
        "test",
        "-race",
        "-count=1",
        "./..."
      ],
      "changedCmd": [
        "go",
        "test",
        "-race",
        "-count=1",
        "{changedGoPkgs}"
      ]
    },
    {"name": "vet", "cmd": ["go", "vet", "./..."]},
    {"name": "tagged-spike", "cmd": ["go", "test", "-race", "-count=1", "-tags=sddprobe", "./spikes"]}
  ],
  "timeoutMs": 120000,
  "projects": [
    {
      "root": "simulator",
      "dependsOn": ["internal", "model", "finalizer", "runtime"],
      "testCmd": ["go", "test", "./...", "-count=1", "-run", "{IDU}(_|$)"],
      "checks": [
        {"name": "test", "cmd": ["go", "test", "-race", "-count=1", "./..."]},
        {"name": "vet", "cmd": ["go", "vet", "./..."]}
      ]
    }
  ]
}
