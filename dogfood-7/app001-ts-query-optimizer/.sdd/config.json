{
  "schemaVersion": 1,
  "testCmd": [
    "node",
    "--test",
    "--test-name-pattern",
    "{id}(?![0-9A-Za-z])",
    "{file}"
  ],
  "prepare": {
    "cmd": [
      "npm",
      "run",
      "build"
    ],
    "outputs": [],
    "timeoutMs": 600000
  },
  "checks": [
    {
      "name": "typecheck",
      "cmd": [
        "npm",
        "run",
        "typecheck"
      ]
    }
  ],
  "projects": [
    {
      "root": "packages/algebra",
      "testCmd": ["node", "--test", "--test-name-pattern", "{id}(?![0-9A-Za-z])", "{file}"],
      "checks": [{ "name": "test", "cmd": ["node", "--test", "test/*.test.ts"] }]
    },
    {
      "root": "packages/optimizer",
      "dependsOn": ["./packages/algebra/"],
      "testCmd": ["node", "--test", "--test-name-pattern", "{id}(?![0-9A-Za-z])", "{file}"],
      "checks": [{ "name": "test", "cmd": ["node", "--test", "test/*.test.ts"] }]
    },
    {
      "root": "packages/cli",
      "dependsOn": ["packages/algebra", "packages/optimizer/"],
      "testCmd": ["node", "--test", "--test-name-pattern", "{id}(?![0-9A-Za-z])", "{file}"],
      "checks": [{ "name": "test", "cmd": ["node", "--test", "test/*.test.ts"] }]
    }
  ],
  "timeoutMs": 120000
}
