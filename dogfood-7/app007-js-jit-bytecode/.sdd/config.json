{
  "schemaVersion": 1,
  "testCmd": [
    "node",
    "--test",
    "--test-name-pattern",
    "{id}(?![0-9A-Za-z])",
    "{file}"
  ],
  "scan": { "include": ["src/**/*.js", "tests/**/*.js"], "exclude": ["spikes/**"] },
  "checks": [
    { "name": "test", "cmd": ["npm", "test"], "changedCmd": ["node", "--test", "{changedTests}"], "hubFallbackCmd": ["node", "--test", "{changedTests}"] },
    { "name": "syntax", "cmd": ["npm", "run", "check"] }
  ],
  "timeoutMs": 120000
}
