{
  "schemaVersion": 1,
  "testCmd": [
    "node",
    "--test",
    "--test-name-pattern",
    "{id}(?![0-9A-Za-z])",
    "{file}"
  ],
  "checks": [
    {
      "name": "typecheck",
      "cmd": [
        "npm",
        "run",
        "typecheck"
      ]
    },
    {
      "name": "test",
      "cmd": [
        "npm",
        "run",
        "test"
      ]
    }
  ],
  "timeoutMs": 120000,
  "projects": [
    {
      "root":"packages/text",
      "testCmd":["node","--test","--test-name-pattern","{id}(?![0-9A-Za-z])","{file}"],
      "checks":[{"name":"test","cmd":["node","--test","test/text.test.ts"]}]
    },
    {
      "root":"packages/parser",
      "dependsOn":["./packages/text/"],
      "testCmd":["node","--test","--test-name-pattern","{id}(?![0-9A-Za-z])","{file}"],
      "checks":[{"name":"test","cmd":["node","--test","test/parser.test.ts"]}]
    },
    {
      "root":"packages/symbols",
      "dependsOn":["packages/parser/","packages/text/"],
      "testCmd":["node","--test","--test-name-pattern","{id}(?![0-9A-Za-z])","{file}"],
      "checks":[{"name":"test","cmd":["node","--test","test/symbols.test.ts"]}]
    },
    {
      "root":"packages/navigation",
      "dependsOn":["packages/symbols/","packages/parser/","packages/text/"],
      "testCmd":["node","--test","--test-name-pattern","{id}(?![0-9A-Za-z])","{file}"],
      "checks":[{"name":"test","cmd":["node","--test","test/navigation.test.ts"]}]
    },
    {
      "root":"packages/diagnostics",
      "dependsOn":["packages/navigation/","packages/symbols/","packages/parser/","packages/text/"],
      "testCmd":["node","--test","--test-name-pattern","{id}(?![0-9A-Za-z])","{file}"],
      "checks":[{"name":"test","cmd":["node","--test","test/diagnostics.test.ts"]}]
    }
  ]
}
