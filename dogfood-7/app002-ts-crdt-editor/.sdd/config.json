{
  "schemaVersion": 1,
  "testCmd": [
    "node",
    "--test",
    "--test-name-pattern",
    "{id}(?![0-9A-Za-z])",
    "{file}"
  ],
  "checks": [
    {
      "name": "typecheck",
      "cmd": [
        "npm",
        "run",
        "typecheck"
      ]
    }
  ],
  "projects": [
    {
      "root": "packages/sequence",
      "testCmd": ["node","--test","--test-name-pattern","{id}(?![0-9A-Za-z])","{file}"],
      "checks": [{"name":"test","cmd":["sh","-c","node --test test/*.test.ts"]}]
    },
    {
      "root": "packages/causal",
      "dependsOn": ["./packages/sequence/"],
      "testCmd": ["node","--test","--test-name-pattern","{id}(?![0-9A-Za-z])","{file}"],
      "checks": [{"name":"test","cmd":["sh","-c","node --test test/*.test.ts"]}]
    },
    {
      "root": "packages/history",
      "dependsOn": ["packages/causal","packages/sequence"],
      "testCmd": ["node","--test","--test-name-pattern","{id}(?![0-9A-Za-z])","{file}"],
      "checks": [{"name":"test","cmd":["sh","-c","node --test test/*.test.ts"]}]
    },
    {
      "root": "packages/cursor",
      "dependsOn": ["packages/sequence","packages/history"],
      "testCmd": ["node","--test","--test-name-pattern","{id}(?![0-9A-Za-z])","{file}"],
      "checks": [{"name":"test","cmd":["sh","-c","node --test test/*.test.ts"]}]
    },
    {
      "root": "packages/simulation",
      "dependsOn": ["packages/history","packages/causal","packages/cursor","packages/sequence"],
      "testCmd": ["node","--test","--test-name-pattern","{id}(?![0-9A-Za-z])","{file}"],
      "checks": [{"name":"test","cmd":["sh","-c","node --test test/*.test.ts"]}]
    }
  ],
  "timeoutMs": 120000
}
